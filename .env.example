# Edital Enrichment Pipeline

# Provedor de IA — usado para ler o PDF dos editais (FAPES, CONIF, CAPES, CNPq,
# PRPPG/IFES, PROEX/IFES), classificar títulos de documentos da FAPES e a
# categoria das chamadas FINEP. Só o nível GRATUITO é usado: nada de cartão nem
# conta de faturamento. Detalhes em docs/ia_extracao.md.
# gemini (padrão) ou mistral.
LLM_PROVIDER=gemini

# Chave do Gemini (Google AI Studio, nível gratuito), de um projeto usado só pelo
# coletor: a cota é por projeto, e outro uso no mesmo projeto a consome. Sem ela, os itens que
# dependem da IA ficam adiados para a próxima execução (o fluxo aparece como
# Atenção); fluxos que não usam IA rodam normalmente.
GEMINI_API_KEY=sua_chave_gemini_aqui

# Opcionais do Gemini (valores padrão abaixo).
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MIN_INTERVAL_SEC=5        # intervalo mínimo entre chamadas (12/min; o limite gratuito é 15)
# GEMINI_MAX_RETRIES=5             # novas tentativas em 429 por minuto ou erro temporário
# GEMINI_MAX_TOTAL_WAIT_SEC=300    # espera máxima acumulada por chamada
# GEMINI_TIMEOUT_SEC=120           # timeout de cada chamada

# Mistral — provedor opcional (LLM_PROVIDER=mistral).
# MISTRAL_API_KEY=sua_chave_mistral_aqui
# MISTRAL_LLM_MODEL=ministral-14b-latest
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# Jina Reader — desvio automático quando o www.gov.br recusa a conexão direta
# (CAPES e CNPq no GitHub Actions). Gratuito e sem cadastro; tudo opcional.
# JINA_API_KEY=              # chave gratuita, só se o limite sem cadastro apertar
# JINA_MIN_INTERVAL_SEC=4    # intervalo entre chamadas ao Jina
# JINA_MAX_RETRIES=3
# JINA_MAX_TOTAL_WAIT_SEC=120
# JINA_TIMEOUT_SEC=60

# Indicações da comunidade (spec 009): token com permissão só de Issues no
# RafaelDeps/portal_edital, para responder e fechar as indicações. Opcional.
# PORTAL_ISSUES_TOKEN=
# COMUNIDADE_MAX_POR_EXECUCAO=10

# Dias que um edital encerrado fica em data/output/ antes de ir para data/arquivo/.
# ARCHIVE_GRACE_DAYS=30

# Dias que um item com erro na transformação fica fora antes de ser tentado de novo.
# TRANSFORM_ERROR_TTL_DAYS=3

# Spec 010: intervalo da releitura dos editais em fluxo contínuo por falta de prazo,
# e teto de alterações lidas junto com o edital original.
# RELEITURA_FLUXO_CONTINUO_DIAS=7
# MAX_ALTERACOES_POR_EDITAL=3

# Spec 011: quantos editais abertos sem elegibilidade são relidos por execução.
# RELEITURA_ELEGIBILIDADE_MAX=40

# Ano de referência para filtro de editais (ex.: FINEP).
# Só entram chamadas cujo prazo de envio de propostas termina neste ano ou depois.
# Se não definido, usa o ano atual.
# REFERENCE_YEAR=2026
